; COSTA LIVRE - Jogo original de mundo aberto leve
config_version=5

[application]
config/name="COSTA LIVRE | Mundo Aberto"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Prototipo original de exploracao costeira, carros e pedestres com IA por regras."

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window/override_width=960
window/size/window/override_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1
textures/canvas_textures/default_texture_filter=1
lights_and_shadows/use_physical_light_units=false

[physics]
3d/default_gravity=9.8
